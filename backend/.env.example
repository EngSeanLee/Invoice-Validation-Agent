# Copy this file to .env and fill in real values. See README.md "Setup" for
# step-by-step instructions on creating the Google Cloud service account and
# sharing the target Sheet.

# --- Required ---

# Anthropic API key. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Either the raw JSON content of your Google service account key, or a path
# to the downloaded key file (e.g. ./service-account-key.json). Never commit
# this file or its contents -- it's gitignored.
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account-key.json

# The target Google Sheet's ID (the long string in its URL between /d/ and /edit)
SHEET_ID=

# --- Optional / tunable ---

# Claude model used for invoice extraction. Sonnet 5 is a good cost/quality
# default; override to claude-opus-5 for higher accuracy on messy scans.
CLAUDE_MODEL=claude-sonnet-5

# Anomaly detection thresholds -- see app/services/anomaly.py
ANOMALY_ZSCORE_THRESHOLD=2.0
ANOMALY_SIGNAL_THRESHOLD=2

# Comma-separated list of origins allowed to call this API (the frontend dev
# server, by default)
CORS_ALLOWED_ORIGINS=http://localhost:5173
